@page "/scrape"
@using System.Threading

@inject HttpClient Http
@inject ISnackbar Snackbar
@implements IDisposable

<PageTitle>Scrapování – RealEstate</PageTitle>

<MudStack Spacing="4" Class="pa-4">

    <MudText Typo="Typo.h5" Class="fw-bold">
        <MudIcon Icon="@Icons.Material.Filled.Sync" Class="mb-1 mr-1" />
        Správa scrapování
    </MudText>

    <!-- Stats panel -->
    @if (_stats != null)
    {
        <MudPaper Elevation="1" Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-3">Stav databáze</MudText>
            <MudGrid>
                <MudItem xs="6" sm="3">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Celkem inzerátů</MudText>
                    <MudText Typo="Typo.h6">@_stats.TotalListings</MudText>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Normalizováno</MudText>
                    <MudText Typo="Typo.h6">@_stats.WithNormalizedData <MudText Inline="true" Typo="Typo.caption" Color="Color.Secondary">(@NormPct %)</MudText></MudText>
                    <MudProgressLinear Value="@NormPct" Color="@PctColor(NormPct)" Rounded="true" Size="Size.Small" />
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Smart-tagy</MudText>
                    <MudText Typo="Typo.h6">@_stats.WithSmartTags <MudText Inline="true" Typo="Typo.caption" Color="Color.Secondary">(@TagsPct %)</MudText></MudText>
                    <MudProgressLinear Value="@TagsPct" Color="@PctColor(TagsPct)" Rounded="true" Size="Size.Small" />
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Cenový signál</MudText>
                    <MudText Typo="Typo.h6">@_stats.WithPriceSignal <MudText Inline="true" Typo="Typo.caption" Color="Color.Secondary">(@PricePct %)</MudText></MudText>
                    <MudProgressLinear Value="@PricePct" Color="@PctColor(PricePct)" Rounded="true" Size="Size.Small" />
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">AI shrnutí</MudText>
                    <MudText Typo="Typo.h6">@_stats.WithSummary <MudText Inline="true" Typo="Typo.caption" Color="Color.Secondary">(@SummaryPct %)</MudText></MudText>
                    <MudProgressLinear Value="@SummaryPct" Color="@PctColor(SummaryPct)" Rounded="true" Size="Size.Small" />
                </MudItem>
            </MudGrid>
        </MudPaper>
    }

    <!-- Karta pro spuštění -->
    <MudPaper Elevation="2" Class="pa-4">
        <MudText Typo="Typo.h6" Class="mb-3">1. Stáhnout nové inzeráty</MudText>

        <!-- Výběr zdrojů -->
        <MudText Typo="Typo.body2" Class="mb-1">Zdroje (prázdné = všechny aktivní)</MudText>
        @if (_availableSources.Count > 0)
        {
            <MudChipSet T="string" @bind-SelectedValues="_selectedSourceCodes"
                        SelectionMode="SelectionMode.MultiSelection"
                        CheckMark="true"
                        Class="mb-3">
                @foreach (var src in _availableSources.Where(s => s.IsActive))
                {
                    <MudChip T="string" Value="@src.Code" Size="Size.Small" Variant="Variant.Outlined">
                        @src.Code
                    </MudChip>
                }
            </MudChipSet>
        }
        else if (_loadingSources)
        {
            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mb-3" />
        }

        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="4" Class="mb-3">
            <MudSwitch @bind-Value="_fullRescan" Color="Color.Warning">
                Plný rescan (ignoruj cache, přepiš vše)
            </MudSwitch>
            <MudSwitch @bind-Value="_autoRunAi" Color="Color.Success">
                Po stažení automaticky spustit AI analýzu
            </MudSwitch>
        </MudStack>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.PlayArrow"
                   Size="Size.Large"
                   Disabled="@(_scraping || _aiRunning)"
                   OnClick="TriggerScrapeAsync">
            @if (_scraping)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>Stahuji…</span>
            }
            else
            {
                <span>Spustit scrapování</span>
            }
        </MudButton>

        @if (_scraping)
        {
            <MudStack Spacing="1" Class="mt-3">
                <MudText Typo="Typo.body2">@ScrapeStatusText</MudText>
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" Rounded="true" />
            </MudStack>
        }
    </MudPaper>

    <!-- AI zpracování -->
    <MudPaper Elevation="2" Class="pa-4">
        <MudText Typo="Typo.h6" Class="mb-1">2. Spustit AI analýzu</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
            Zpracuje nové inzeráty bez AI dat: normalizace textu, smart-tagy a cenový signál.
        </MudText>

        @if (_aiRunning)
        {
            <MudStack Spacing="1" Class="mb-3">
                <MudText Typo="Typo.body2">@_aiStatus</MudText>
                <MudProgressLinear Indeterminate="true" Color="Color.Success" Rounded="true" />
            </MudStack>
        }

        <MudButton Variant="Variant.Filled"
                   Color="Color.Success"
                   StartIcon="@Icons.Material.Filled.AutoAwesome"
                   Disabled="@(_aiRunning || _scraping)"
                   OnClick="RunAiJobsAsync">
            @if (_aiRunning)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>Zpracovávám…</span>
            }
            else
            {
                <span>Spustit AI analýzu</span>
            }
        </MudButton>
    </MudPaper>

    <!-- Čištění mrtvých inzerátů -->
    <MudPaper Elevation="2" Class="pa-4">
        <MudText Typo="Typo.h6" Class="mb-1">3. Vyčistit mrtvé inzeráty</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
            Zkontroluje HTTP HEAD na zdrojové URL každého aktivního inzerátu, který nebyl viděn
            déle než <strong>@_deadDaysOld dní</strong>. Inzeráty vracející 404/410 budou deaktivovány.
        </MudText>

        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="mb-3">
            <MudNumericField T="int" @bind-Value="_deadDaysOld" Label="Starší než (dní)"
                             Min="1" Max="365" Variant="Variant.Outlined" Style="width:160px" />
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Warning"
                       StartIcon="@Icons.Material.Filled.DeleteSweep"
                       Disabled="@(_cleaning || _scraping || _aiRunning)"
                       OnClick="DeactivateDeadAsync">
                @if (_cleaning)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    <span>Kontroluji…</span>
                }
                else
                {
                    <span>Vyčistit mrtvé</span>
                }
            </MudButton>
        </MudStack>

        @if (_cleanResult is not null)
        {
            <MudAlert Severity="@(_cleanResult.Deactivated > 0 ? Severity.Warning : Severity.Success)"
                      Variant="Variant.Outlined">
                Zkontrolováno: <strong>@_cleanResult.Checked</strong> inzerátů &nbsp;|&nbsp;
                Deaktivováno: <strong>@_cleanResult.Deactivated</strong>
            </MudAlert>
        }
    </MudPaper>

    <!-- Výsledek posledního scrape jobu -->
    @if (_lastJob is not null)
    {
        <MudAlert Severity="@(_lastJob.Status == "Failed" ? Severity.Error : Severity.Success)"
                  Variant="Variant.Outlined">
            <strong>Scrapování:</strong> @(_lastJob.Status == "Failed" ? "selhalo" : "dokončeno")
            (@_lastJob.CreatedAt.ToLocalTime().ToString("d. M. H:mm"))
            @if (!string.IsNullOrWhiteSpace(_lastJob.ErrorMessage))
            {
                <span> — @_lastJob.ErrorMessage</span>
            }
        </MudAlert>
    }

    <!-- Přehled zdrojů -->
    <MudPaper Elevation="1" Class="pa-4">
        <MudText Typo="Typo.h6" Class="mb-3">Přehled zdrojů</MudText>
        @if (_loadingSources)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else
        {
            <MudTable Items="_availableSources" Dense="true" Hover="true" Elevation="0">
                <HeaderContent>
                    <MudTh>Kód</MudTh>
                    <MudTh>Název</MudTh>
                    <MudTh>URL</MudTh>
                    <MudTh>Aktivní</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd><strong>@context.Code</strong></MudTd>
                    <MudTd>@context.Name</MudTd>
                    <MudTd>
                        <MudLink Href="@context.BaseUrl" Target="_blank" Typo="Typo.caption">@context.BaseUrl</MudLink>
                    </MudTd>
                    <MudTd>
                        <MudChip T="string" Size="Size.Small"
                                 Color="@(context.IsActive ? Color.Success : Color.Default)"
                                 Variant="Variant.Filled">
                            @(context.IsActive ? "Aktivní" : "Neaktivní")
                        </MudChip>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudPaper>

</MudStack>

@code {
    private bool _scraping;
    private bool _aiRunning;
    private bool _cleaning;
    private bool _loadingSources = true;
    private bool _fullRescan;
    private bool _autoRunAi = true;
    private int _deadDaysOld = 7;
    private string _aiStatus = "";
    private List<SourceDto> _availableSources = new();
    private IReadOnlyCollection<string> _selectedSourceCodes = new List<string>();
    private ScrapeJobDto? _lastJob;
    private string _scrapeStatus = "";
    private DateTime _scrapeCreatedAt;
    private DeactivateDeadResultDto? _cleanResult;
    private OllamaStatsDto? _stats;
    private CancellationTokenSource _cts = new();

    private int NormPct => _stats?.TotalListings > 0 ? (int)(100.0 * _stats.WithNormalizedData / _stats.TotalListings) : 0;
    private int TagsPct => _stats?.TotalListings > 0 ? (int)(100.0 * _stats.WithSmartTags / _stats.TotalListings) : 0;
    private int SummaryPct => _stats?.TotalListings > 0 ? (int)(100.0 * _stats.WithSummary / _stats.TotalListings) : 0;
    private int PricePct => _stats?.TotalListings > 0 ? (int)(100.0 * _stats.WithPriceSignal / _stats.TotalListings) : 0;
    private Color PctColor(int pct) => pct >= 90 ? Color.Success : pct >= 70 ? Color.Warning : Color.Error;

    /// <summary>Starší „Running" job už neběží – scraper spadl nebo byl restartován uprostřed (v DB jich pár visí).</summary>
    private static readonly TimeSpan ScrapeJobMaxAge = TimeSpan.FromHours(3);
    private static readonly TimeSpan ScrapePollInterval = TimeSpan.FromSeconds(5);

    private string ScrapeStatusText
    {
        get
        {
            var minutes = (int)(DateTime.UtcNow - _scrapeCreatedAt).TotalMinutes;
            var state = _scrapeStatus == "Queued" ? "Ve frontě" : "Scraper běží";
            return _scrapeCreatedAt == default ? "Spouštím scraper…" : $"{state} – {minutes} min";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadSourcesAsync(), LoadStatsAsync(), ResumeRunningScrapeAsync());
    }

    /// <summary>Po návratu na stránku navážeme na scrape, který pořád běží.</summary>
    private async Task ResumeRunningScrapeAsync()
    {
        try
        {
            var jobs = await Http.GetFromJsonAsync<List<ScrapeJobDto>>("api/scraping/jobs?limit=1", _cts.Token);
            var job = jobs?.FirstOrDefault();
            if (job is null) return;
            if (IsFinished(job.Status))
            {
                _lastJob = job;
                return;
            }
            if (DateTime.UtcNow - job.CreatedAt.ToUniversalTime() > ScrapeJobMaxAge) return;

            StartTracking(job);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            // Stav jobu je jen doplněk – stránka funguje i bez něj
        }
    }

    private static bool IsFinished(string status) => status is "Succeeded" or "Failed";

    private void StartTracking(ScrapeJobDto job)
    {
        _scraping = true;
        _scrapeStatus = job.Status;
        _scrapeCreatedAt = job.CreatedAt.ToUniversalTime();
        _ = TrackScrapeAsync(job.JobId);
    }

    /// <summary>Hlídá job, dokud nedoběhne; pak obnoví statistiky a případně pustí AI analýzu.</summary>
    private async Task TrackScrapeAsync(Guid jobId)
    {
        ScrapeJobDto? finished = null;
        try
        {
            using var timer = new PeriodicTimer(ScrapePollInterval);
            while (await timer.WaitForNextTickAsync(_cts.Token))
            {
                ScrapeJobDto? job;
                try
                {
                    job = await Http.GetFromJsonAsync<ScrapeJobDto>($"api/scraping/jobs/{jobId}", _cts.Token);
                }
                catch (HttpRequestException)
                {
                    continue; // výpadek spojení se scraperem – zkusíme to při dalším tiknutí
                }

                if (job is null) continue;
                _scrapeStatus = job.Status;
                if (IsFinished(job.Status))
                {
                    finished = job;
                    break;
                }
                if (DateTime.UtcNow - _scrapeCreatedAt > ScrapeJobMaxAge)
                {
                    Snackbar.Add("Scrapování běží přes 3 hodiny – přestávám ho sledovat, zkontroluj logy scraperu.", Severity.Warning);
                    break;
                }
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) when (_cts.IsCancellationRequested)
        {
            return; // odchod ze stránky
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Nepodařilo se sledovat scrapování: {ex.Message}", Severity.Warning);
        }

        _scraping = false;
        _lastJob = finished;
        if (finished?.Status == "Failed")
            Snackbar.Add($"Scrapování selhalo: {finished.ErrorMessage}", Severity.Error);
        else if (finished is not null)
            Snackbar.Add("Scrapování dokončeno.", Severity.Success);

        await LoadStatsAsync();
        await InvokeAsync(StateHasChanged);

        if (finished?.Status == "Succeeded" && _autoRunAi && !_aiRunning)
            await InvokeAsync(RunAiJobsAsync);
    }

    private async Task LoadSourcesAsync()
    {
        try
        {
            var sources = await Http.GetFromJsonAsync<List<SourceDto>>("api/sources", _cts.Token);
            _availableSources = sources ?? new();
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Snackbar.Add($"Nepodařilo se načíst zdroje: {ex.Message}", Severity.Warning);
        }
        finally
        {
            _loadingSources = false;
        }
    }

    private async Task LoadStatsAsync()
    {
        try
        {
            _stats = await Http.GetFromJsonAsync<OllamaStatsDto>("api/ollama/stats", _cts.Token);
        }
        catch { /* stats jsou optional */ }
    }

    private async Task TriggerScrapeAsync()
    {
        _scraping = true;
        _lastJob = null;
        _scrapeCreatedAt = default;
        try
        {
            var request = new
            {
                sourceCodes = _selectedSourceCodes.Count > 0 ? _selectedSourceCodes.ToList() : null,
                fullRescan = _fullRescan,
            };
            var response = await Http.PostAsJsonAsync("api/scraping/trigger", request, _cts.Token);
            response.EnsureSuccessStatusCode();
            var result = await response.Content.ReadFromJsonAsync<ScrapeTriggerResultDto>(cancellationToken: _cts.Token);
            if (result is null || result.Status == "Failed" || result.JobId == Guid.Empty)
            {
                Snackbar.Add($"Scrapování selhalo: {result?.Message}", Severity.Error);
                _scraping = false;
                return;
            }

            // AI analýza se pouští až po doběhnutí scrapu – dřív běžela 3 s po startu nad starými daty
            Snackbar.Add("Scrapování bylo spuštěno – inzeráty se stahují na pozadí.", Severity.Success);
            StartTracking(new ScrapeJobDto(result.JobId, result.Status, DateTime.UtcNow, null));
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Snackbar.Add($"Chyba: {ex.Message}", Severity.Error);
            _scraping = false;
        }
    }

    private async Task RunAiJobsAsync()
    {
        _aiRunning = true;
        try
        {
            // Normalize
            _aiStatus = "Normalizuji texty…";
            StateHasChanged();
            for (int i = 0; i < 40; i++)
            {
                var r = await Http.PostAsync($"api/ollama/bulk-normalize?batchSize=50", null, _cts.Token);
                if (!r.IsSuccessStatusCode) break;
                var dto = await r.Content.ReadFromJsonAsync<BulkJobResultDto>(cancellationToken: _cts.Token);
                if (dto?.RemainingUnprocessed == 0) break;
            }

            // Smart-tags
            _aiStatus = "Generuji smart-tagy…";
            StateHasChanged();
            for (int i = 0; i < 40; i++)
            {
                var r = await Http.PostAsync($"api/ollama/bulk-smart-tags?batchSize=50", null, _cts.Token);
                if (!r.IsSuccessStatusCode) break;
                var dto = await r.Content.ReadFromJsonAsync<BulkJobResultDto>(cancellationToken: _cts.Token);
                if (dto?.RemainingUnprocessed == 0) break;
            }

            // AI shrnutí – veřejná náhrada původního popisu
            _aiStatus = "Generuji shrnutí…";
            StateHasChanged();
            for (int i = 0; i < 40; i++)
            {
                var r = await Http.PostAsync($"api/ollama/bulk-summary?batchSize=20", null, _cts.Token);
                if (!r.IsSuccessStatusCode) break;
                var dto = await r.Content.ReadFromJsonAsync<BulkJobResultDto>(cancellationToken: _cts.Token);
                if (dto?.RemainingUnprocessed == 0) break;
            }

            // Price opinion
            _aiStatus = "Vyhodnocuji ceny…";
            StateHasChanged();
            for (int i = 0; i < 60; i++)
            {
                var r = await Http.PostAsync($"api/ollama/bulk-price-opinion?batchSize=30", null, _cts.Token);
                if (!r.IsSuccessStatusCode) break;
                var dto = await r.Content.ReadFromJsonAsync<BulkJobResultDto>(cancellationToken: _cts.Token);
                if (dto?.RemainingUnprocessed == 0) break;
            }

            Snackbar.Add("AI analýza dokončena!", Severity.Success);
            await LoadStatsAsync();
            StateHasChanged();
        }
        catch (Exception ex) when (!_cts.IsCancellationRequested)
        {
            // Včetně timeoutu HttpClientu – nezachycená výjimka by shodila celý okruh a spinner by zůstal viset
            Snackbar.Add($"AI analýza selhala: {ex.Message}", Severity.Error);
        }
        catch (OperationCanceledException)
        {
            return; // odchod ze stránky
        }
        finally
        {
            _aiRunning = false;
            _aiStatus = "";
        }
        await InvokeAsync(StateHasChanged);
    }

    // Bez Dispose CTS – sledovací smyčka může ještě sáhnout na token, Cancel ji ukončí
    public void Dispose() => _cts.Cancel();

    private async Task DeactivateDeadAsync()
    {
        _cleaning = true;
        _cleanResult = null;
        StateHasChanged();
        try
        {
            var response = await Http.PostAsync(
                $"/api/listings/deactivate-dead?daysOld={_deadDaysOld}",
                null, _cts.Token);
            if (response.IsSuccessStatusCode)
            {
                _cleanResult = await response.Content
                    .ReadFromJsonAsync<DeactivateDeadResultDto>(cancellationToken: _cts.Token);
                Snackbar.Add(
                    $"Hotovo: zkontrolováno {_cleanResult?.Checked}, deaktivováno {_cleanResult?.Deactivated}",
                    _cleanResult?.Deactivated > 0 ? Severity.Warning : Severity.Success);
            }
            else
            {
                Snackbar.Add("Chyba při čištění mrtvých inzerátů.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Chyba: {ex.Message}", Severity.Error);
        }
        finally
        {
            _cleaning = false;
            StateHasChanged();
        }
    }

    private record SourceDto(Guid Id, string Code, string Name, string BaseUrl, bool IsActive);
    private record ScrapeTriggerResultDto(Guid JobId, string Status, string? Message);
    private record ScrapeJobDto(Guid JobId, string Status, DateTime CreatedAt, string? ErrorMessage);
    private record OllamaStatsDto(int TotalListings, int WithNormalizedData, int WithSmartTags, int WithPriceSignal, int WithSummary = 0);
    private record BulkJobResultDto(int Processed, int Succeeded, int Failed, int RemainingUnprocessed);
    private record DeactivateDeadResultDto(int Checked, int Deactivated);
}
